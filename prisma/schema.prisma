// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String // 'oauth' or 'credentials' or 'email'
  provider          String // 'google', 'github', 'credentials', 'azure', etc.
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // Extended tracking fields
  isPrimary  Boolean   @default(false) // Is this the primary login method?
  isActive   Boolean   @default(true) // Can this method be used to login?
  lastUsedAt DateTime? // Last time this account was used to login
  timesUsed  Int       @default(0) // How many times used to login
  linkedAt   DateTime  @default(now()) // When was this account linked

  // Metadata
  email       String? // Email from OAuth provider (for reference)
  displayName String? // Name from OAuth provider
  profileUrl  String? // OAuth profile URL
  avatarUrl   String? // OAuth avatar URL

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
  @@index([isPrimary])
  @@index([lastUsedAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Current session location tracking
  sessionIpAddress   String?
  sessionIpv4        String?
  sessionIpv6        String?
  sessionCity        String?
  sessionState       String?
  sessionCountry     String?
  sessionCountryFlag String?
  sessionUserAgent   String? // Browser/OS info for device detection

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // composite: quick lookup for sessions for a user and expiry checks
  @@index([userId, expires])
}

model User {
  id                    String           @id @default(cuid())
  name                  String?
  email                 String?          @unique
  emailVerified         DateTime?
  image                 String?          @db.LongText
  password              String? // For credentials login
  authMethod            String           @default("credentials") // 'credentials', 'oauth', 'both' - tracks how user can authenticate
  role                  UserRole         @default(ERP_CUSTOMER) // Default to ERP_CUSTOMER for new signups
  plan                  SubscriptionPlan @default(GUEST) // GUEST until they select a plan (ERP_CUSTOMER) or assigned role-specific plan
  billingCycle          BillingCycle     @default(MONTHLY) // Monthly or Annual billing preference
  trialEndsAt           DateTime? // 30-day trial period end date
  isActive              Boolean          @default(true) // Account status (can be disabled by super admin)
  canSetupPersonalEmail Boolean          @default(false) // Allow user to connect personal email provider (Office365, Gmail)

  // Email verification fields
  verificationToken        String?   @unique
  verificationTokenExpires DateTime?

  // MFA/2FA fields
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String? // TOTP secret (encrypted)
  mfaBackupCodes Json? // Array of backup codes (hashed)
  mfaSetupAt     DateTime? // When MFA was enabled

  // Address fields
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  countryCode  String? // ISO 2-letter code (US, CA, FR, etc.)
  postalCode   String?
  latitude     Float?
  longitude    Float?

  // Current/Last location tracking fields
  capturedIpAddress   String?
  capturedCity        String?
  capturedState       String?
  capturedCountry     String?
  capturedCountryFlag String?

  // Last login tracking fields (from previous session)
  lastLoginIpAddress   String?
  lastLoginCity        String?
  lastLoginState       String?
  lastLoginCountry     String?
  lastLoginCountryFlag String?
  lastLoginAt          DateTime?

  accounts            Account[]
  sessions            Session[]
  passwordResets      PasswordReset[]
  auditLogs           AuditLog[]
  ownedCompanies      Company[]            @relation("CompanyOwner")
  companyMemberships  CompanyMember[]
  companyStaff        CompanyStaff[]
  failedLoginAttempts FailedLoginAttempt[]
  blockedIps          IpBlacklist[]        @relation("BlockedBy")
  emailTemplates      EmailTemplate[] // Created email templates
  emailProviders      UserEmailProvider[] // Personal email providers (Office365, Gmail OAuth)
  uploadedFiles       FileRecord[] // Files uploaded by user

  // Storefront relations
  storefrontOrders StorefrontOrder[] @relation("StorefrontOrders")
  carts            Cart[]

  // Project relations (as customer)
  customerProjects Project[] @relation("ProjectCustomer") // Projects where this user is the customer

  // Storefront blog posts authored by this user
  storefrontPosts StorefrontPost[]

  // AI storefront generation logs
  aiStorefrontGenerations AiStorefrontGenerationLog[]

  // V4 conversations and websites
  v4Conversations V4Conversation[]
  v4Websites      V4Website[]

  // Support / Knowledge Base articles authored by this user
  supportArticles SupportArticle[]

  // Payment system relations
  invoices Invoice[]

  // OAuth onboarding relation (single token for OAuth-driven new users)
  oauthOnboarding OAuthOnboarding?

  customerPaymentProviders CustomerPaymentProvider[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([email])
}

// Payment provider enum and mapping table for external customer IDs
enum PaymentProvider {
  STRIPE
  PAYPAL
  OTHER
}

model CustomerPaymentProvider {
  id         String          @id @default(cuid())
  userId     String
  provider   PaymentProvider
  externalId String
  metadata   Json?
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Password Reset Token
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // (no composite indexes here) - keep token/expiry indexes only

  @@index([userId])
  @@index([token])
  @@index([expires])
}

// Company Model
model Company {
  id            String  @id @default(cuid())
  name          String
  slogan        String?
  description   String? @db.Text
  industry      CompanyIndustry? // Company industry/vertical classification
  logo          String? @db.LongText // Can store file path or base64 data URL
  logoLight     String? @db.LongText // Logo for light theme (path or base64)
  logoDark      String? @db.LongText // Logo for dark theme (path or base64)
  uploadedLogos Json?   @db.Json // Temporary storage for uploaded base64 logos before assignment
  website       String?
  phone         String?
  email         String?
  salesEmail    String? // Sales inquiries email
  supportEmail  String? // Customer support email
  isRoot        Boolean @default(false) // True for OnTarget ERP (the SaaS provider)
  isActive      Boolean @default(true) // Company active status (disabled if trial expired and invoice unpaid)

  // Storefront fields
  slug              String?   @unique // URL-friendly slug: "my-company-name" -> /store/my-company-name
  subdomain         String?   @unique // Custom subdomain: "mycompany.ontarget-erp.com"
  customDomain      String?   @unique // Custom domain: "shop.mycompany.com"
  isStoreEnabled    Boolean   @default(false) // Enable/disable public storefront
  storeTheme        String?   @default("default") // "default", "minimal", "modern", "classic"
  storeBanner       String? // Hero banner image for store homepage
  storeMetadata     Json? // SEO metadata, social links, store hours, etc.
  storeBlogEnabled  Boolean   @default(false) // Enable/disable blog/posts section for storefront
  storeConfiguredAt DateTime?
  storeConfiguredBy String? // User ID who configured the store

  // AI Storefront (Growth / Enterprise plans)
  aiStorefrontEnabled Boolean @default(false) // If true, render storefront from AI spec
  aiStorefrontSpec    Json? // Full AI storefront specification (AiFrontstoreSpec)

  // Address fields
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  countryCode  String? // ISO 2-letter code (US, CA, FR, etc.)
  postalCode   String?
  latitude     Float?
  longitude    Float?

  ownerId   String
  owner     User            @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   CompanyMember[]
  staff     CompanyStaff[]
  auditLogs AuditLog[]

  // Subscription relations
  rootSubscriptions       Subscription[] @relation("RootCompany")
  subscriberSubscriptions Subscription[] @relation("SubscriberCompany")

  // Catalog relations
  products Product[]
  services Service[]

  // Storefront relations
  storefrontOrders StorefrontOrder[] @relation("StorefrontOrders")
  carts            Cart[]
  storefrontPosts  StorefrontPost[]

  // Project Management relations
  teams            Team[]
  projects         Project[]
  customerProjects Project[] @relation("ProjectSubscriberCustomer") // Projects where this company is the customer

  // Financial relations
  ledger Ledger?

  // Payment system relations
  paymentGateways PaymentGateway[]
  plaidAccounts   PlaidAccount[]
  invoices        Invoice[]
  payments        Payment[]

  // Stripe Connect (for marketplace platform fees)
  stripeConnectedAccountId String?   @unique // Stripe Connected Account ID
  stripeAccountStatus      String?   @default("not_connected") // "not_connected", "pending", "active", "restricted"
  stripeOnboardedAt        DateTime? // When they completed Stripe Connect onboarding
  customPlatformFeePercent Decimal?  @db.Decimal(5, 2) // Override platform fee (null = use plan default)

  // AI storefront usage
  aiStorefrontGenerations AiStorefrontGenerationLog[]
  storefrontConversations StorefrontConversation[]
  storefrontSpecVersions  StorefrontSpecVersion[]
  storefrontWebsitesV3    StorefrontWebsiteV3[] // V3 multi-page websites

  // V4 conversations and generated websites
  v4Conversations V4Conversation[]
  v4Websites      V4Website[]

  // Storage configuration - NEW SYSTEM: Uses StorageProvider table
  // Subscription-based backup: ESSENTIAL (uses global), PROFESSIONAL (optional backup), ENTERPRISE (no backup)
  storageBackupEnabled Boolean @default(true) // If true and has custom storage, also backup to global storage (charged feature)
  storageUsedGB        Float   @default(0) // Track storage usage for plan limit enforcement

  // DEPRECATED: Legacy storage config - kept for backward compatibility, use StorageProvider table instead
  storageProvider     String?   @default("INHERIT") // DEPRECATED: Use StorageProvider table
  storageConfig       Json? // DEPRECATED: Use StorageProvider table
  storageConfiguredAt DateTime?
  storageConfiguredBy String? // User ID who configured it

  // OAuth configuration (company can override global OAuth settings)
  oauthSettings CompanyOAuthSetting[] @relation("CompanyOAuthSettings")

  // File system relations
  folders FileFolder[] // Company folder structure

  // Time tracking
  timeEntries TimeEntry[]

  // Payroll
  payrollJurisdictions PayrollJurisdiction[]

  // Testimonial relations
  testimonials Testimonial[]

  // Multi-location support
  locations CompanyLocation[]

  // Tax and legal entity information
  taxInfo CompanyTaxInfo?

  // Back-relations for models referencing Company
  telemetryEvents TelemetryEvent[]
  leads           Lead[]
  webhookConfigs  WebhookConfig[]

  // Support / Knowledge Base articles for this company
  supportArticles SupportArticle[]

  // Social proof & metrics (for V4 AI generation)
  foundedYear        Int?
  employeeCount      Int?
  instagramFollowers Int?
  facebookLikes      Int?
  linkedinFollowers  Int?
  youtubeSubscribers Int?
  trustpilotRating   Float?
  googleRating       Float?
  certifications     Json? // Array of certification names
  awards             Json? // Array of award names

  // Social media links
  facebookUrl  String?
  twitterUrl   String?
  instagramUrl String?
  linkedinUrl  String?
  youtubeUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // (no composite indexes added here by accident)

  @@index([ownerId])
  @@index([name])
  @@index([isRoot])
}

