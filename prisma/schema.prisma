  companyId     String
  key           String   // e.g., "product", "service", "menu"
  singularLabel String
  pluralLabel   String
  schemaOverrides Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
}

enum SectionLayout {
  IMAGE_LEFT
  IMAGE_RIGHT
  IMAGE_CENTER
  SPLIT
  TEXT_ONLY
  CTA_GRID
  MEDIA_COVER
}

enum BackgroundStyle {
  SOLID_COLOR
  GRADIENT
  IMAGE_COVER
  IMAGE_COVER_OVERLAY
  TRANSPARENT
}

model GeneratedSection {
  id             String         @id @default(cuid())
  companyId      String
  pageId         String?        // optional page-scoped section
  personaId      String?
  kind           SectionKind
  layout         SectionLayout? // layout variant for rendering (image-left, split, etc.)
  background     BackgroundStyle? // background style (solid, gradient, image)
  backgroundConfig Json?         // color, gradient stops, overlay opacity
  componentName  String?        // optional: TSX component key to render
  schema         Json           // structured content for the section
  props          Json?          // optional explicit props for component rendering
  variants       Json?          // array of variant objects { variantId, layout, schema, assets, meta }
  assets         Json?          // array of asset objects { url, alt, type }
  status         SectionStatus  @default(PENDING)
  generatedBy    String?        // user id
  generatedAt    DateTime?
  acceptedAt     DateTime?
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([companyId])
  @@index([pageId])
}

model GeneratedPageDraft {
  id         String   @id @default(cuid())
  companyId  String
  pageId     String?  // reference to Page model when draft is page-scoped
  pageSlug   String?
  pageTitle  String?
  name       String?
  sections   Json     // ordered array of section IDs
  meta       Json?
  version    Int      @default(1)
  createdBy  String?
  status     DraftStatus @default(DRAFT)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([pageId])
}

model GenerationJob {
  id         String   @id @default(cuid())
  companyId  String
  sectionKind SectionKind
  personaId  String?
  inputPrompt String  @db.Text
  status     JobStatus @default(QUEUED)
  logs       Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([companyId])
}

// Page model for multi-page sites
model Page {
  id             String   @id @default(cuid())
  companyId      String
  slug           String
  title          String
  meta           Json?
  publishedDraftId String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@unique([companyId, slug])
}

model NavigationItem {
  id         String  @id @default(cuid())
  companyId  String
  label      String
  pageId     String?
  url        String?
  order      Int     @default(0)
  parentId   String?
  visible    Boolean @default(true)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([pageId])
}

model ServiceSchedule {
  id         String  @id @default(cuid())
  companyId  String
  serviceId  String? // link to product/service if applicable
  title      String
  timezone   String?
  recurrence Json?   // e.g., rrule or recurrence rules
  slots      Json?   // array of {start, end, capacity}
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

model Booking {
  id        String       @id @default(cuid())
  scheduleId String
  customerName String
  customerEmail String
  slotStart DateTime
  slotEnd   DateTime
  status    BookingStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
}

model Asset {
  id        String  @id @default(cuid())
  companyId String
  url       String
  type      String? // image, video, svg, generated
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

