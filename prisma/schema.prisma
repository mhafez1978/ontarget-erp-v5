  ADMIN // Company admin - can manage company settings and members
  MANAGER // Company manager - can manage staff and operations
  STAFF // Company staff - limited permissions within company
  ERP_CUSTOMER // Paying ERP subscriber - can create companies per their plan
  COMPANY_CUSTOMER // Customer of a subscriber company - added by company or via store
  CONTRACTOR // External contractor working with company
  SUPPLIER // Supplier/vendor of a company
}

// Plan Pricing Configuration - allows dynamic pricing management
model PlanPricing {
  id   String @id @default(cuid())
  plan String @unique // ESSENTIAL, GROWTH, ENTERPRISE

  // Monthly pricing
  monthlyPrice      Float
  monthlyPromoPrice Float?

  // Annual pricing
  annualPrice        Float
  annualPriceMonthly Float

  // Transaction fees
  transactionFeePercent Float
  transactionFeeFixed   Float

  // Storage
  baseStorageGB             Int
  extraStoragePricePer100GB Float
  extraStoragePricePerGB    Float

  // Marketing
  isPopular Boolean @default(false)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // User ID who created/updated

  @@index([plan])
}

// Promo Code Model - for special pricing offers like beta testing
model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "OnTargetLove"
  description String?  @db.Text
  
  // Discount type and amounts
  discountType String // "FLAT_FEE", "PERCENTAGE", "FREE_TRIAL"
  flatFeeAmount Decimal? @db.Decimal(10, 2) // Fixed monthly fee (e.g., 0.99)
  percentageOff Int? // Percentage discount (0-100)
  freeTrialDays Int? // Days of free trial
  
  // Validity
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  
  // Usage limits
  maxUses    Int? // null = unlimited uses
  timesUsed  Int       @default(0)
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // User ID who created it
  
  // Relations
  subscriptions Subscription[]
  
  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
}
