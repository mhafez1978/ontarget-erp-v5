generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  isPrimary         Boolean   @default(false)
  isActive          Boolean   @default(true)
  lastUsedAt        DateTime?
  timesUsed         Int       @default(0)
  linkedAt          DateTime  @default(now())
  email             String?
  displayName       String?
  profileUrl        String?
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
  @@index([isPrimary])
  @@index([lastUsedAt])
}

model Session {
  id                 String   @id @default(cuid())
  sessionToken       String   @unique
  userId             String
  expires            DateTime
  sessionIpAddress   String?
  sessionIpv4        String?
  sessionIpv6        String?
  sessionCity        String?
  sessionState       String?
  sessionCountry     String?
  sessionCountryFlag String?
  sessionUserAgent   String?
  user               User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([userId])
  @@index([userId, expires])
}

model User {
  id                       String                      @id @default(cuid())
  name                     String?
  email                    String?                     @unique
  emailVerified            DateTime?
  image                    String?
  password                 String?
  authMethod               String                      @default("credentials")
  role                     UserRole                    @default(ERP_CUSTOMER)
  plan                     SubscriptionPlan            @default(TRIAL)
  billingCycle             BillingCycle                @default(MONTHLY)
  trialEndsAt              DateTime?
  isActive                 Boolean                     @default(true)
  canSetupPersonalEmail    Boolean                     @default(false)
  verificationToken        String?                     @unique
  verificationTokenExpires DateTime?
  mfaEnabled               Boolean                     @default(false)
  mfaSecret                String?
  mfaBackupCodes           Json?
  mfaSetupAt               DateTime?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  country                  String?
  countryCode              String?
  postalCode               String?
  latitude                 Float?
  longitude                Float?
  capturedIpAddress        String?
  capturedCity             String?
  capturedState            String?
  capturedCountry          String?
  capturedCountryFlag      String?
  lastLoginIpAddress       String?
  lastLoginCity            String?
  lastLoginState           String?
  lastLoginCountry         String?
  lastLoginCountryFlag     String?
  lastLoginAt              DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  deletedAt                DateTime?
  primaryAddressId         String?                     @unique
  accounts                 Account[]
  addresses                Address[]                   @relation("UserAddresses")
  aiStorefrontGenerations  AiStorefrontGenerationLog[]
  auditLogs                AuditLog[]
  carts                    Cart[]
  ownedCompanies           Company[]                   @relation("CompanyOwner")
  companyMemberships       CompanyMember[]
  companyStaff             CompanyStaff[]
  customerPaymentProviders CustomerPaymentProvider[]
  emailTemplates           EmailTemplate[]
  failedLoginAttempts      FailedLoginAttempt[]
  uploadedFiles            FileRecord[]
  invoices                 Invoice[]
  blockedIps               IpBlacklist[]               @relation("BlockedBy")
  oauthOnboarding          OAuthOnboarding?
  passwordResets           PasswordReset[]
  customerProjects         Project[]                   @relation("ProjectCustomer")
  sessions                 Session[]
  storefrontOrders         StorefrontOrder[]           @relation("StorefrontOrders")
  storefrontPosts          StorefrontPost[]
  supportArticles          SupportArticle[]
  primaryAddress           Address?                    @relation("UserPrimaryAddress", fields: [primaryAddressId], references: [id])
  emailProviders           UserEmailProvider[]
  profile                  UserProfile?
  v4Conversations          V4Conversation[]
  v4Websites               V4Website[]

  @@index([role])
  @@index([email])
}

model UserProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  settings  Json?
  metrics   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction)
}

model Address {
  id                        String           @id @default(cuid())
  line1                     String
  line2                     String?
  city                      String?
  state                     String?
  postalCode                String?
  country                   String?
  countryCode               String?
  latitude                  Float?
  longitude                 Float?
  label                     AddressLabel?
  isPrimary                 Boolean          @default(false)
  userId                    String?
  companyId                 String?
  companyLocationId         String?
  metadata                  Json?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  deletedAt                 DateTime?
  company                   Company?         @relation("CompanyAddresses", fields: [companyId], references: [id], onDelete: NoAction)
  companyLocation           CompanyLocation? @relation("CompanyLocationAddresses", fields: [companyLocationId], references: [id], onDelete: NoAction)
  user                      User?            @relation("UserAddresses", fields: [userId], references: [id])
  primaryForCompany         Company?         @relation("CompanyPrimaryAddress")
  primaryForCompanyLocation CompanyLocation? @relation("CompanyLocationPrimary")
  primaryForUser            User?            @relation("UserPrimaryAddress")

  @@index([userId])
  @@index([companyId])
  @@index([companyLocationId])
  @@index([countryCode])
  @@index([postalCode])
}

model CustomerPaymentProvider {
  id         String          @id @default(cuid())
  userId     String
  provider   PaymentProvider
  externalId String
  metadata   Json?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@unique([provider, externalId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([userId])
  @@index([token])
  @@index([expires])
}

model Company {
  id                       String                      @id @default(cuid())
  name                     String
  legalName                String?
  slogan                   String?
  description              String?
  industry                 CompanyIndustry?
  logo                     String?
  logoLight                String?
  logoDark                 String?
  uploadedLogos            Json?
  website                  String?
  phone                    String?
  email                    String?
  salesEmail               String?
  supportEmail             String?
  isRoot                   Boolean                     @default(false)
  isActive                 Boolean                     @default(true)
  slug                     String?                     @unique
  subdomain                String?                     @unique
  customDomain             String?                     @unique
  isStoreEnabled           Boolean                     @default(false)
  storeTheme               String?                     @default("default")
  storeBanner              String?
  storeMetadata            Json?
  storeBlogEnabled         Boolean                     @default(false)
  storeConfiguredAt        DateTime?
  storeConfiguredBy        String?
  aiStorefrontEnabled      Boolean                     @default(false)
  aiStorefrontSpec         Json?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  country                  String?
  countryCode              String?
  postalCode               String?
  latitude                 Float?
  longitude                Float?
  ownerId                  String
  stripeConnectedAccountId String?                     @unique
  stripeAccountStatus      String?                     @default("not_connected")
  stripeOnboardedAt        DateTime?
  customPlatformFeePercent Decimal?                    @db.Decimal(5, 2)
  storageBackupEnabled     Boolean                     @default(true)
  storageUsedGB            Float                       @default(0)
  storageProvider          String?                     @default("INHERIT")
  storageConfig            Json?
  storageConfiguredAt      DateTime?
  storageConfiguredBy      String?
  foundedYear              Int?
  employeeCount            Int?
  instagramFollowers       Int?
  facebookLikes            Int?
  linkedinFollowers        Int?
  youtubeSubscribers       Int?
  trustpilotRating         Float?
  googleRating             Float?
  certifications           Json?
  awards                   Json?
  facebookUrl              String?
  twitterUrl               String?
  instagramUrl             String?
  linkedinUrl              String?
  youtubeUrl               String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  deletedAt                DateTime?
  primaryAddressId         String?                     @unique
  addresses                Address[]                   @relation("CompanyAddresses")
  aiStorefrontGenerations  AiStorefrontGenerationLog[]
  auditLogs                AuditLog[]
  carts                    Cart[]
  owner                    User                        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: NoAction)
  primaryAddress           Address?                    @relation("CompanyPrimaryAddress", fields: [primaryAddressId], references: [id])
  companyHederaSetting     CompanyHederaSetting?
  hederaTransactions       HederaTransaction[]
  locations                CompanyLocation[]
  members                  CompanyMember[]
  oauthSettings            CompanyOAuthSetting[]       @relation("CompanyOAuthSettings")
  staff                    CompanyStaff[]
  taxInfo                  CompanyTaxInfo?
  folders                  FileFolder[]
  invoices                 Invoice[]
  leads                    Lead[]
  ledger                   Ledger?
  payments                 Payment[]
  paymentGateways          PaymentGateway[]
  plaidAccounts            PlaidAccount[]
  products                 Product[]
  projects                 Project[]
  customerProjects         Project[]                   @relation("ProjectSubscriberCustomer")
  services                 Service[]
  storefrontConversations  StorefrontConversation[]
  storefrontOrders         StorefrontOrder[]           @relation("StorefrontOrders")
  storefrontPosts          StorefrontPost[]
  storefrontSpecVersions   StorefrontSpecVersion[]
  storefrontWebsitesV3     StorefrontWebsiteV3[]
  rootSubscriptions        Subscription[]              @relation("RootCompany")
  subscriberSubscriptions  Subscription[]              @relation("SubscriberCompany")
  supportArticles          SupportArticle[]
  teams                    Team[]
  telemetryEvents          TelemetryEvent[]
  testimonials             Testimonial[]
  timeEntries              TimeEntry[]
  v4Conversations          V4Conversation[]
  v4Websites               V4Website[]
  webhookConfigs           WebhookConfig[]
  payrollJurisdictions     PayrollJurisdiction[]       @relation("CompanyToPayrollJurisdiction")

  @@index([ownerId])
  @@index([name])
  @@index([isRoot])
}

model CompanyTaxInfo {
  id          String             @id @default(cuid())
  companyId   String             @unique
  legalEntity CompanyLegalEntity
  taxIdType   TaxIdType
  taxId       String
  taxCountry  String?
  vatNumber   String?
  verifiedAt  DateTime?
  verifiedBy  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([taxCountry])
}

model AiStorefrontGenerationLog {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  plan      SubscriptionPlan
  createdAt DateTime         @default(now())
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

model V4Conversation {
  id             String      @id @default(cuid())
  companyId      String
  userId         String
  phase          String      @default("greeting")
  heroStyle      String?
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  fontPairing    String?
  designStyle    String?
  sections       Json?
  isComplete     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       V4Message[]
  websites       V4Website[]

  @@index([companyId])
  @@index([userId])
  @@index([companyId, isComplete])
}

model V4Message {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  phase          String
  createdAt      DateTime       @default(now())
  conversation   V4Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model V4Website {
  id              String          @id @default(cuid())
  companyId       String
  conversationId  String?
  userId          String
  websiteData     Json
  preferences     Json
  qualityScore    Float           @default(0)
  creativityScore Float           @default(0)
  isActive        Boolean         @default(false)
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation    V4Conversation? @relation(fields: [conversationId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([conversationId])
  @@index([userId])
  @@index([companyId, isActive])
}

model StorefrontPost {
  id             String    @id @default(cuid())
  companyId      String
  authorId       String?
  title          String
  slug           String
  excerpt        String?
  content        String
  heroImage      String?
  status         String    @default("DRAFT")
  tags           String?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  author         User?     @relation(fields: [authorId], references: [id])
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([status])
}

model SupportArticle {
  id              String   @id @default(cuid())
  companyId       String?
  authorId        String
  title           String
  slug            String
  summary         String?
  category        String?
  tags            String?
  featuredImage   String?
  content         String
  isGlobal        Boolean  @default(false)
  readTimeMinutes Int      @default(5)
  status          String   @default("PUBLISHED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  company         Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([authorId])
  @@index([status])
}

model Testimonial {
  id            String    @id @default(cuid())
  companyId     String
  customerName  String
  customerEmail String
  customerTitle String?
  customerPhoto String?
  rating        Int       @default(5)
  testimonial   String
  status        String    @default("PENDING")
  approvedBy    String?
  approvedAt    DateTime?
  isFeatured    Boolean   @default(false)
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([isFeatured])
  @@unique([customerEmail, companyId])
}

model Subscription {
  rootCompanyId          String
  subscriberCompanyId    String
  plan                   SubscriptionPlan   @default(ESSENTIAL)
  status                 SubscriptionStatus @default(TRIAL)
  billingCycle           BillingCycle       @default(MONTHLY)
  trialEndsAt            DateTime?
  billingCycleStart      DateTime?
  billingCycleEnd        DateTime?
  externalSubscriptionId String?
  promoCodeId            String?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  promoCode              PromoCode?         @relation(fields: [promoCodeId], references: [id])
  rootCompany            Company            @relation("RootCompany", fields: [rootCompanyId], references: [id], onDelete: Cascade)
  subscriberCompany      Company            @relation("SubscriberCompany", fields: [subscriberCompanyId], references: [id], onDelete: Cascade)

  @@unique([rootCompanyId, subscriberCompanyId])
  @@index([rootCompanyId])
  @@index([subscriberCompanyId])
  @@index([status])
  @@index([plan])
  @@index([trialEndsAt])
  @@index([promoCodeId])
  @@index([subscriberCompanyId, status])
}

model CompanyLocation {
  id               String       @id @default(cuid())
  companyId        String
  name             String
  type             LocationType @default(BRANCH)
  isMain           Boolean      @default(false)
  addressLine1     String
  addressLine2     String?
  city             String
  state            String?
  country          String
  postalCode       String?
  latitude         Float
  longitude        Float
  phone            String?
  email            String?
  hours            String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  primaryAddressId String?      @unique
  addresses        Address[]    @relation("CompanyLocationAddresses")
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryAddress   Address?     @relation("CompanyLocationPrimary", fields: [primaryAddressId], references: [id])
  products         Product[]

  @@index([companyId])
  @@index([isMain])
  @@index([companyId, isMain])
}

model CompanyMember {
  id        String            @id @default(cuid())
  userId    String
  companyId String
  role      CompanyMemberRole @default(COMPANY_STAFF)
  joinedAt  DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([role])
  @@index([companyId, role])
}

model CompanyStaff {
  id                       String                  @id @default(cuid())
  userId                   String
  companyId                String
  role                     CompanyMemberRole       @default(COMPANY_STAFF)
  jobTitle                 String?
  employmentType           EmploymentType          @default(FULL_TIME)
  status                   EmploymentStatus        @default(ACTIVE)
  hireDate                 DateTime                @default(now())
  terminationDate          DateTime?
  city                     String?
  state                    String?
  country                  String?
  countryCode              String?
  countryFlag              String?
  notes                    String?
  isFeatured               Boolean                 @default(false)
  bio                      String?
  displayOrder             Int?                    @default(0)
  onboardingComplete       Boolean                 @default(false)
  canReceivePayroll        Boolean                 @default(false)
  isActive                 Boolean                 @default(true)
  payrollJurisdictionId    String?
  employmentClassification String?
  payRate                  Decimal?                @db.Decimal(10, 2)
  payFrequency             String?                 @default("HOURLY")
  currency                 String?                 @default("USD")
  taxWithholdingConfig     Json?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  company                  Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollJurisdiction      PayrollJurisdiction?    @relation(fields: [payrollJurisdictionId], references: [id])
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  employmentDocuments      EmploymentDocument[]
  expenseEntries           ExpenseEntry[]
  onboardingToken          OnboardingToken?
  payrollEntries           PayrollEntry[]
  managedProjects          Project[]               @relation("ProjectManager")
  ledProjects              Project[]               @relation("TeamLead")
  projectDocuments         ProjectDocument[]       @relation("ProjectDocumentUploader")
  projectFinancialEntries  ProjectFinancialEntry[] @relation("ProjectFinancialEntryCreator")
  projectNotes             ProjectNote[]
  assignedTasks            Task[]                  @relation("TaskAssignee")
  createdTasks             Task[]                  @relation("TaskCreator")
  teamMemberships          TeamMember[]
  timeEntries              TimeEntry[]

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([role])
  @@index([employmentType])
  @@index([status])
  @@index([hireDate])
  @@index([payrollJurisdictionId])
  @@index([jobTitle])
}

model AuditLog {
  id          String    @id @default(cuid())
  action      String
  entityType  String?
  entityId    String?
  description String?
  metadata    String?
  userId      String?
  companyId   String?
  ipAddress   String?
  deletedAt   DateTime?
  ipv4        String?
  ipv6        String?
  city        String?
  state       String?
  country     String?
  countryFlag String?
  createdAt   DateTime  @default(now())
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: NoAction)
  user        User?     @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([userId])
  @@index([companyId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@index([companyId, createdAt])
}

model GeoTrackingSetting {
  id        String   @id @default(cuid())
  enabled   Boolean  @default(false)
  provider  String   @default("IP_API")
  apiKey    String?
  apiUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([provider])
}

model GeoLocationRecord {
  id            String   @id @default(cuid())
  ip            String
  ipv4          String?
  ipv6          String?
  provider      String
  providerRaw   Json?
  city          String?
  region        String?
  regionName    String?
  district      String?
  zip           String?
  countryName   String?
  countryCode   String?
  continent     String?
  continentCode String?
  isp           String?
  org           String?
  as            String?
  asName        String?
  mobile        Boolean?
  proxy         Boolean?
  hosting       Boolean?
  dnsGeo        String?
  dnsIp         String?
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  timezone      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ip])
  @@index([countryCode])
  @@index([createdAt])
}

model OAuthProviderSetting {
  id           String   @id @default(cuid())
  provider     String   @unique
  enabled      Boolean  @default(false)
  clientId     String?
  clientSecret String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([provider])
  @@index([enabled])
}

model CompanyOAuthSetting {
  id           String   @id @default(cuid())
  companyId    String
  provider     String
  enabled      Boolean  @default(false)
  clientId     String?
  clientSecret String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation("CompanyOAuthSettings", fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
  @@index([provider])
  @@index([enabled])
}

model VisitorTracking {
  id          String   @id @default(cuid())
  ipAddress   String
  ipv4        String?
  ipv6        String?
  city        String?
  state       String?
  country     String?
  countryFlag String?
  userAgent   String?
  referrer    String?
  landingPage String?
  visitedAt   DateTime @default(now())

  @@index([ipAddress])
  @@index([visitedAt])
}

model Product {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String?               @unique
  description          String?
  price                Decimal               @db.Decimal(10, 2)
  unitCost             Decimal?              @db.Decimal(13, 2)
  markupPercent        Decimal?              @db.Decimal(5, 2)
  markupAmount         Decimal?              @db.Decimal(13, 2)
  profitMarginPercent  Decimal?              @db.Decimal(5, 2)
  sku                  String?
  category             String?
  isPublished          Boolean               @default(true)
  isFeatured           Boolean               @default(false)
  isActive             Boolean               @default(true)
  quantity             Int                   @default(0)
  lowStockAlert        Int?                  @default(10)
  trackInventory       Boolean               @default(true)
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  country              String?
  countryCode          String?
  postalCode           String?
  latitude             Float?
  longitude            Float?
  companyLocationId    String?
  companyId            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  cartItems            CartItem[]
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyLocation      CompanyLocation?      @relation(fields: [companyLocationId], references: [id], onDelete: Cascade)
  images               ProductImage[]
  storefrontOrderItems StorefrontOrderItem[]

  @@index([companyId])
  @@index([name])
  @@index([category])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([isActive])
}

model ProductImage {
  id         String   @id @default(cuid())
  url        String
  isFeatured Boolean  @default(false)
  order      Int      @default(0)
  altText    String?
  productId  String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@index([productId])
  @@index([isFeatured])
}

model Service {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String?               @unique
  description          String?
  price                Decimal               @db.Decimal(10, 2)
  unitCost             Decimal?              @db.Decimal(13, 2)
  markupPercent        Decimal?              @db.Decimal(5, 2)
  markupAmount         Decimal?              @db.Decimal(13, 2)
