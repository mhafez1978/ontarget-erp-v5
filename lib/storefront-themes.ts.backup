export interface ThemeSection {
  id: string;
  type:
    | "hero"
    | "social-proof"
    | "featured-products"
    | "featured-services"
    | "about"
    | "contact"
    | "footer"
    | "promo-banner"
    | "video-section"
    | "gallery";
  enabled: boolean;
  order: number;
  content: {
    [key: string]:
      | string
      | string[]
      | boolean
      | number
      | Record<string, unknown>
      | Array<Record<string, unknown>>
      | undefined;
  };
  styling?: {
    backgroundColor?: string;
    textColor?: string;
    gradient?: string;
    backgroundImage?: string;
    overlay?: string;
    pattern?: string;
  };
}

export interface StorefrontTheme {
  id: string;
  name: string;
  description: string;
  thumbnail: string;
  previewImage?: string;
  category:
    | "seasonal"
    | "industry"
    | "event"
    | "modern"
    | "classic"
    | "minimal"
    | "bold"
    | "creative";
  season?: "spring" | "summer" | "fall" | "winter" | "holiday";
  event?:
    | "black-friday"
    | "cyber-monday"
    | "halloween"
    | "christmas"
    | "new-year"
    | "valentines"
    | "easter"
    | "memorial-day"
    | "independence-day"
    | "labor-day"
    | "veterans-day"
    | "thanksgiving";
  industry?:
    | "tech"
    | "retail"
    | "food"
    | "services"
    | "healthcare"
    | "real-estate"
    | "education"
    | "creative";
  colors: {
    primary: string;
    secondary: string;
    accent: string;
    background?: string;
    text?: string;
  };
  sections: ThemeSection[];
  features?: {
    videoBackground?: boolean;
    parallax?: boolean;
    animations?: string[];
    countdown?: boolean;
    chatWidget?: boolean;
  };
}

const createStandardSections = (
  overrides?: Partial<ThemeSection>[]
): ThemeSection[] => {
  const standardSections: ThemeSection[] = [
    {
      id: "hero",
      type: "hero",
      enabled: true,
      order: 1,
      content: {
        heading: "Welcome to [Your Company Name]",
        subheading: "[Your company slogan or tagline]",
        description:
          "Discover our exceptional products and services designed to meet your needs",
        primaryCTA: "Explore Products",
        secondaryCTA: "View Services",
        showScrollIndicator: true,
      },
    },
    {
      id: "social-proof",
      type: "social-proof",
      enabled: true,
      order: 2,
      content: {
        heading: "Trusted by Industry Leaders",
        description:
          "Join thousands of satisfied customers who trust us with their business",
        stats: [
          { label: "Happy Customers", value: "10,000+", icon: "users" },
          { label: "Projects Delivered", value: "5,000+", icon: "package" },
          { label: "Years of Excellence", value: "15+", icon: "award" },
          { label: "5-Star Reviews", value: "4.9/5", icon: "star" },
        ],
        testimonials: [
          {
            name: "Sarah Johnson",
            role: "CEO, Tech Innovations Inc",
            company: "Tech Innovations Inc",
            comment:
              "Working with this team has transformed our business. Their attention to detail and commitment to excellence is unmatched.",
            rating: 5,
            image: "",
          },
          {
            name: "Michael Chen",
            role: "Operations Director",
            company: "Global Solutions Ltd",
            comment:
              "Exceptional service from start to finish. They delivered beyond our expectations and continue to provide outstanding support.",
            rating: 5,
            image: "",
          },
          {
            name: "Emily Rodriguez",
            role: "Business Owner",
            company: "Creative Studios",
            comment:
              "Professional, reliable, and innovative. They've been instrumental in our growth and success.",
            rating: 5,
            image: "",
          },
        ],
      },
    },
    {
      id: "featured-products",
      type: "featured-products",
      enabled: true,
      order: 3,
      content: {
        heading: "Featured Products",
        description:
          "Discover our hand-picked selection of premium products tailored to your needs",
        viewAllText: "View All Products",
        viewAllLink: "/products",
      },
    },
    {
      id: "featured-services",
      type: "featured-services",
      enabled: true,
      order: 4,
      content: {
        heading: "Professional Services",
        description:
          "Expert services delivered with precision and care to help you succeed",
        viewAllText: "Explore All Services",
        viewAllLink: "/services",
      },
    },
    {
      id: "about",
      type: "about",
      enabled: true,
      order: 5,
      content: {
        heading: "About [Company Name]",
        description: "Who we are and what drives us",
        content:
          "We are a team of passionate professionals dedicated to delivering exceptional quality and service. With years of industry experience and a commitment to innovation, we help our clients achieve their goals and exceed their expectations. Our mission is to provide solutions that make a real difference.",
        features: [
          {
            title: "Quality First",
            description: "We never compromise on quality",
            icon: "award",
          },
          {
            title: "Customer Focused",
            description: "Your success is our priority",
            icon: "heart",
          },
          {
            title: "Innovation Driven",
            description: "Always pushing boundaries",
            icon: "lightbulb",
          },
          {
            title: "Reliable Support",
            description: "We're here when you need us",
            icon: "shield",
          },
        ],
        showTeamButton: true,
        teamButtonText: "Meet Our Team",
      },
    },
    {
      id: "contact",
      type: "contact",
      enabled: true,
      order: 6,
      content: {
        heading: "Get In Touch",
        description:
          "We'd love to hear from you. Reach out to our team for any inquiries.",
        email: "[Your general email]",
        salesEmail: "[Your sales email]",
        supportEmail: "[Your support email]",
        phone: "[Your phone number]",
        address: "[Your business address]",
        showContactForm: true,
        businessHours: "Monday - Friday: 9:00 AM - 6:00 PM",
        responseTime: "We typically respond within 24 hours",
      },
    },
    {
      id: "footer",
      type: "footer",
      enabled: true,
      order: 7,
      content: {
        description:
          "Your trusted partner for exceptional products and services",
        tagline: "Quality. Service. Excellence.",
        companyInfo:
          "We're committed to providing the best products and services to help you achieve your goals.",
        quickLinks: [
          { label: "Products", url: "/products" },
          { label: "Services", url: "/services" },
          { label: "About Us", url: "#about" },
          { label: "Contact", url: "#contact" },
        ],
        legalLinks: [
          { label: "Privacy Policy", url: "/privacy" },
          { label: "Terms of Service", url: "/terms" },
          { label: "Refund Policy", url: "/refund-policy" },
        ],
        socialLinks: {
          facebook: "",
          twitter: "",
          instagram: "",
          linkedin: "",
        },
        showNewsletter: true,
        newsletterHeading: "Stay Updated",
        newsletterDescription:
          "Subscribe to our newsletter for the latest updates and offers",
        copyrightText: "All rights reserved.",
      },
    },
  ];

  // Apply overrides if provided
  if (overrides) {
    overrides.forEach((override) => {
      const sectionIndex = standardSections.findIndex(
        (s) => s.id === override.id
      );
      if (sectionIndex !== -1) {
        standardSections[sectionIndex] = {
          ...standardSections[sectionIndex],
          ...override,
          content: {
            ...standardSections[sectionIndex].content,
            ...override.content,
          },
        };
      }
    });
  }

  return standardSections;
};

