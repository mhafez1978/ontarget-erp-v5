{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noEmit": true,
    "allowJs": true,
    "types": ["node", "mocha", "chai", "@testing-library/jest-dom"],
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx", "types/**/*.d.ts"]
}
