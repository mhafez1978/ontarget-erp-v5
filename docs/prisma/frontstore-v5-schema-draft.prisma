// Draft Prisma models for Frontstore V5 (do NOT apply to main schema until reviewed)
// Models below are intended for MySQL with Prisma client 6.x

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
enum SectionKind {
  HERO
  ABOUT
  MENU              // legacy (kept for compatibility)
  FOOD_MENU         // food/restaurant menu

  // Top navbars (explicit logged-in / logged-out variants)
  LOGGED_IN_TOP_NAVBAR
  LOGGED_OUT_TOP_NAVBAR

  // Side navbars
  LOGGED_IN_SIDE_NAVBAR
  LOGGED_OUT_SIDE_NAVBAR

  // Mobile navbars
  LOGGED_IN_MOBILE_NAVBAR
  LOGGED_OUT_MOBILE_NAVBAR

  TESTIMONIAL
  CTA
  GALLERY
  SERVICES
  FEEDBACK
  CUSTOM
}

enum SectionStatus {
  PENDING
  GENERATED
  ACCEPTED
  REJECTED
  EDITED
}

enum DraftStatus {
  DRAFT
  PUBLISHED
}

enum JobStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Persona {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  promptTemplate String? @db.Text
  defaultModel  String?
  promptVersion String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CompanyVocabulary {
  id            String   @id @default(cuid())
  companyId     String
  key           String   // e.g., "product", "service", "food-menu"
  singularLabel String
  pluralLabel   String
  schemaOverrides Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
}

model GeneratedSection {
  id          String       @id @default(cuid())
  companyId   String
  personaId   String?
  kind        SectionKind
  schema      Json         // structured content for the section
  assets      Json?        // array of asset objects { url, alt, type }
  status      SectionStatus @default(PENDING)
  generatedBy String?      // user id
  generatedAt DateTime?
  acceptedAt  DateTime?
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId])
}

model GeneratedPageDraft {
  id         String   @id @default(cuid())
  companyId  String
  name       String?
  sections   Json     // ordered array of section IDs
  meta       Json?
  version    Int      @default(1)
  createdBy  String?
  status     DraftStatus @default(DRAFT)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

model GenerationJob {
  id         String   @id @default(cuid())
  companyId  String
  sectionKind SectionKind
  personaId  String?
  inputPrompt String  @db.Text
  status     JobStatus @default(QUEUED)
  logs       Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([companyId])
}

model ServiceSchedule {
  id         String  @id @default(cuid())
  companyId  String
  serviceId  String? // link to product/service if applicable
  title      String
  timezone   String?
  recurrence Json?   // e.g., rrule or recurrence rules
  slots      Json?   // array of {start, end, capacity}
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

model Booking {
  id        String       @id @default(cuid())
  scheduleId String
  customerName String
  customerEmail String
  slotStart DateTime
  slotEnd   DateTime
  status    BookingStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
}

model Asset {
  id        String  @id @default(cuid())
  companyId String
  url       String
  type      String? // image, video, svg, generated
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model AuditLog {
  id        String  @id @default(cuid())
  companyId String?
  userId    String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([companyId])
}

// Notes / Migration plan
// 1) Add these models to Prisma schema in a draft branch. Do NOT change existing models.
