"use client";

import { useState, useEffect } from "react";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import {
  Package,
  Briefcase,
  Loader2,
  Image as ImageIcon,
  Search,
  Copy,
} from "lucide-react";
import { AddProductSheet } from "@/components/add-product-sheet";
import { AddServiceSheet } from "@/components/add-service-sheet";

interface AdminCatalogViewProps {
  userName?: string | null;
}

interface Company {
  id: string;
  name: string;
}

interface ProductImage {
  id: string;
  url: string;
  isFeatured: boolean;
  order: number;
}

interface Product {
  id: string;
  name: string;
  description: string | null;
  price: number;
  sku: string | null;
  category: string | null;
  addressLine1: string | null;
  city: string | null;
  state: string | null;
  country: string | null;
  images: ProductImage[];
  company: {
    id: string;
    name: string;
  };
  createdAt: string;
}

interface ServiceImage {
  id: string;
  url: string;
  isFeatured: boolean;
  order: number;
}

interface Service {
  id: string;
  name: string;
  description: string | null;
  price: number;
  duration: string | null;
  category: string | null;
  addressLine1: string | null;
  city: string | null;
  state: string | null;
  country: string | null;
  images: ServiceImage[];
  company: {
    id: string;
    name: string;
  };
  createdAt: string;
}

export function AdminCatalogView({ userName }: AdminCatalogViewProps) {
  const [activeTab, setActiveTab] = useState("products");
  const [isAddingProduct, setIsAddingProduct] = useState(false);
  const [isAddingService, setIsAddingService] = useState(false);
  const [companies, setCompanies] = useState<Company[]>([]);
  const [selectedCompanyId, setSelectedCompanyId] = useState<string>("");
  const [products, setProducts] = useState<Product[]>([]);
  const [services, setServices] = useState<Service[]>([]);
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [searchTerm, setSearchTerm] = useState<string>("");

  // Fetch companies admin owns or is member of
  useEffect(() => {
    const fetchCompanies = async () => {
      try {
        const response = await fetch("/api/company/my-companies");
        const data = await response.json();

        if (response.ok) {
          const companyList = (data.companies || []).map(
            (c: { id: string; name: string }) => ({
              id: c.id,
              name: c.name,
            })
          );
          setCompanies(companyList);
          if (companyList.length > 0) {
            setSelectedCompanyId(companyList[0].id);
          }
        }
      } catch (err) {
        console.error("Error fetching companies:", err);
      }
    };

    fetchCompanies();
  }, []);

  // Fetch products when company changes
  useEffect(() => {
    if (!selectedCompanyId) return;

    const fetchProducts = async () => {
      try {
        setIsLoading(true);
        setError(null);
        const response = await fetch(
          `/api/catalog/products?companyId=${selectedCompanyId}`
        );
        const data = await response.json();

        if (response.ok) {
          setProducts(data.products || []);
        } else {
          setError(data.error || "Failed to fetch products");
        }
      } catch (err) {
        console.error("Error fetching products:", err);
        setError("Failed to fetch products");
      } finally {
        setIsLoading(false);
      }
    };

    if (activeTab === "products") {
      fetchProducts();
    }
  }, [selectedCompanyId, activeTab]);

  // Fetch services when company changes
  useEffect(() => {
    if (!selectedCompanyId) return;

    const fetchServices = async () => {
      try {
        setIsLoading(true);
        setError(null);
        const response = await fetch(
          `/api/catalog/services?companyId=${selectedCompanyId}`
        );
        const data = await response.json();

        if (response.ok) {
          setServices(data.services || []);
        } else {
          setError(data.error || "Failed to fetch services");
        }
      } catch (err) {
        console.error("Error fetching services:", err);
        setError("Failed to fetch services");
      } finally {
        setIsLoading(false);
      }
    };

    if (activeTab === "services") {
      fetchServices();
    }
  }, [selectedCompanyId, activeTab]);

  const handleProductAdded = () => {
    // Refresh products list
    if (selectedCompanyId && activeTab === "products") {
      fetch(`/api/catalog/products?companyId=${selectedCompanyId}`)
        .then((res) => res.json())
        .then((data) => {
          if (data.success) {
            setProducts(data.products || []);
          }
        })
        .catch((err) => console.error("Error refreshing products:", err));
    }
  };

  const handleServiceAdded = () => {
    // Refresh services list
    if (selectedCompanyId && activeTab === "services") {
      fetch(`/api/catalog/services?companyId=${selectedCompanyId}`)
        .then((res) => res.json())
        .then((data) => {
          if (data.success) {
            setServices(data.services || []);
          }
        })
        .catch((err) => console.error("Error refreshing services:", err));
    }
  };

  const handleDuplicateProduct = async (product: Product) => {
    try {
      const response = await fetch("/api/catalog/products", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: `${product.name} (Copy)`,
          description: product.description,
          price: product.price,
          sku: product.sku ? `${product.sku}-COPY` : null,
          category: product.category,
          companyId: product.company.id,
          addressLine1: product.addressLine1,
          city: product.city,
          state: product.state,
          country: product.country,
          images: product.images.map((img) => ({
            url: img.url,
            isFeatured: img.isFeatured,
            order: img.order,
          })),
        }),
      });

      if (response.ok) {
        handleProductAdded();
      }
    } catch (error) {
      console.error("Error duplicating product:", error);
    }
  };

  const handleDuplicateService = async (service: Service) => {
    try {
      const response = await fetch("/api/catalog/services", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: `${service.name} (Copy)`,
          description: service.description,
          price: service.price,
          duration: service.duration,
          category: service.category,
          companyId: service.company.id,
          addressLine1: service.addressLine1,
          city: service.city,
          state: service.state,
          country: service.country,
          images: service.images.map((img) => ({
            url: img.url,
            isFeatured: img.isFeatured,
            order: img.order,
          })),
        }),
      });

      if (response.ok) {
        handleServiceAdded();
      }
    } catch (error) {
      console.error("Error duplicating service:", error);
    }
  };

  const getFeaturedImage = (
    images: ProductImage[] | ServiceImage[]
  ): string | null => {
    const featured = images.find((img) => img.isFeatured);
    return featured?.url || images[0]?.url || null;
  };

  // Filter products based on search term
  const filteredProducts = products.filter((product) => {
    if (!searchTerm) return true;
    const term = searchTerm.toLowerCase();
    return (
      product.name.toLowerCase().includes(term) ||
      product.description?.toLowerCase().includes(term) ||
      product.sku?.toLowerCase().includes(term) ||
      product.category?.toLowerCase().includes(term) ||
      product.addressLine1?.toLowerCase().includes(term) ||
      product.city?.toLowerCase().includes(term) ||
      product.state?.toLowerCase().includes(term) ||
      product.country?.toLowerCase().includes(term)
    );
  });

  // Filter services based on search term
  const filteredServices = services.filter((service) => {
    if (!searchTerm) return true;
    const term = searchTerm.toLowerCase();
    return (
      service.name.toLowerCase().includes(term) ||
      service.description?.toLowerCase().includes(term) ||
      service.category?.toLowerCase().includes(term) ||
      service.duration?.toLowerCase().includes(term) ||
      service.addressLine1?.toLowerCase().includes(term) ||
      service.city?.toLowerCase().includes(term) ||
      service.state?.toLowerCase().includes(term) ||
      service.country?.toLowerCase().includes(term)
    );
  });

  return (
    <div className="space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-bold tracking-tight mb-4">Catalog</h1>
          <p className="text-muted-foreground">
            Welcome back, {userName || "Admin"}! Manage your products and
            services here.
          </p>
        </div>
        {activeTab === "products" && (
          <Button onClick={() => setIsAddingProduct(true)} className="shrink-0">
            <Package className="h-4 w-4 mr-2" />
            Add Product
          </Button>
        )}
        {activeTab === "services" && (
          <Button onClick={() => setIsAddingService(true)} className="shrink-0">
            <Briefcase className="h-4 w-4 mr-2" />
            Add Service
          </Button>
        )}
      </div>

      {/* Company Selector */}
      <Card>
        <CardHeader>
          <CardTitle>Select Company</CardTitle>
        </CardHeader>
        <CardContent>
          <div className="flex items-center gap-4">
            <Select
              value={selectedCompanyId}
              onValueChange={setSelectedCompanyId}
            >
              <SelectTrigger className="w-full max-w-md">
                <SelectValue placeholder="Select a company" />
              </SelectTrigger>
              <SelectContent>
                {companies.map((company) => (
                  <SelectItem key={company.id} value={company.id}>
                    {company.name}
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>

            <div className="relative flex-1 max-w-md ml-auto">
              <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-muted-foreground" />
              <Input
                type="text"
                placeholder="Search products or services..."
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                className="pl-9"
              />
            </div>
          </div>
        </CardContent>
      </Card>

      {/* Tabs for Products and Services */}
      {selectedCompanyId && (
        <Tabs value={activeTab} onValueChange={setActiveTab}>
          <TabsList>
            <TabsTrigger value="products">
              <Package className="h-4 w-4 mr-2" />
              Products
            </TabsTrigger>
            <TabsTrigger value="services">
              <Briefcase className="h-4 w-4 mr-2" />
              Services
            </TabsTrigger>
          </TabsList>

          <TabsContent value="products">
            <Card>
              <CardHeader>
                <CardTitle>
                  Products ({filteredProducts.length}
                  {searchTerm &&
                    products.length !== filteredProducts.length &&
                    ` of ${products.length}`}
                  )
                </CardTitle>
              </CardHeader>
              <CardContent>
                {isLoading ? (
                  <div className="flex items-center justify-center py-12">
                    <Loader2 className="w-6 h-6 animate-spin text-muted-foreground" />
                  </div>
                ) : error ? (
                  <div className="text-center py-12">
                    <p className="text-red-600">{error}</p>
                  </div>
                ) : products.length === 0 ? (
                  <div className="text-center py-12">
                    <Package className="mx-auto h-12 w-12 text-muted-foreground mb-4" />
                    <p className="text-muted-foreground">
                      No products yet. Add your first product to get started.
                    </p>
                  </div>
                ) : filteredProducts.length === 0 ? (
                  <div className="text-center py-12">
                    <Package className="mx-auto h-12 w-12 text-muted-foreground mb-4" />
                    <p className="text-muted-foreground">
                      No products match your search.
                    </p>
                  </div>
                ) : (
                  <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {filteredProducts.map((product) => (
                      <Card
                        key={product.id}
                        className="overflow-hidden group relative"
                      >
                        <Button
                          variant="secondary"
                          size="icon"
                          className="absolute top-2 right-2 z-10 opacity-0 group-hover:opacity-100 transition-opacity"
                          onClick={() => handleDuplicateProduct(product)}
                          title="Duplicate product"
                        >
                          <Copy className="h-4 w-4" />
                        </Button>
                        <div className="aspect-video bg-muted relative">
                          {getFeaturedImage(product.images) ? (
                            // eslint-disable-next-line @next/next/no-img-element
                            <img
                              src={getFeaturedImage(product.images)!}
                              alt={product.name}
                              className="w-full h-full object-cover"
                            />
                          ) : (
                            <div className="w-full h-full flex items-center justify-center">
                              <ImageIcon className="h-12 w-12 text-muted-foreground" />
                            </div>
                          )}
                        </div>
                        <CardContent className="p-4">
                          <h3 className="font-semibold mb-1">{product.name}</h3>
                          {product.description && (
                            <p className="text-sm text-muted-foreground mb-2 line-clamp-2">
                              {product.description}
                            </p>
                          )}
                          <div className="flex items-center justify-between">
                            <span className="text-lg font-bold text-primary">
                              ${parseFloat(product.price.toString()).toFixed(2)}
                            </span>
                            {product.sku && (
                              <span className="text-xs text-muted-foreground">
                                SKU: {product.sku}
                              </span>
                            )}
                          </div>
                          {product.category && (
                            <div className="mt-2">
                              <span className="text-xs bg-secondary px-2 py-1 rounded">
                                {product.category}
                              </span>
                            </div>
                          )}
                          {(product.city || product.state) && (
                            <div className="mt-2 text-xs text-muted-foreground">
                              {[product.city, product.state]
                                .filter(Boolean)
                                .join(", ")}
                            </div>
                          )}
                        </CardContent>
                      </Card>
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>
          </TabsContent>

          <TabsContent value="services">
            <Card>
              <CardHeader>
                <CardTitle>
                  Services ({filteredServices.length}
                  {searchTerm &&
                    services.length !== filteredServices.length &&
                    ` of ${services.length}`}
                  )
                </CardTitle>
              </CardHeader>
              <CardContent>
                {isLoading ? (
                  <div className="flex items-center justify-center py-12">
                    <Loader2 className="w-6 h-6 animate-spin text-muted-foreground" />
                  </div>
                ) : error ? (
                  <div className="text-center py-12">
                    <p className="text-red-600">{error}</p>
                  </div>
                ) : services.length === 0 ? (
                  <div className="text-center py-12">
                    <Briefcase className="mx-auto h-12 w-12 text-muted-foreground mb-4" />
                    <p className="text-muted-foreground">
                      No services yet. Add your first service to get started.
                    </p>
                  </div>
                ) : filteredServices.length === 0 ? (
                  <div className="text-center py-12">
                    <Briefcase className="mx-auto h-12 w-12 text-muted-foreground mb-4" />
                    <p className="text-muted-foreground">
                      No services match your search.
                    </p>
                  </div>
                ) : (
                  <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {filteredServices.map((service) => (
                      <Card
                        key={service.id}
                        className="overflow-hidden group relative"
                      >
                        <Button
                          variant="secondary"
                          size="icon"
                          className="absolute top-2 right-2 z-10 opacity-0 group-hover:opacity-100 transition-opacity"
                          onClick={() => handleDuplicateService(service)}
                          title="Duplicate service"
                        >
                          <Copy className="h-4 w-4" />
                        </Button>
                        <div className="aspect-video bg-muted relative">
                          {getFeaturedImage(service.images) ? (
                            // eslint-disable-next-line @next/next/no-img-element
                            <img
                              src={getFeaturedImage(service.images)!}
                              alt={service.name}
                              className="w-full h-full object-cover"
                            />
                          ) : (
                            <div className="w-full h-full flex items-center justify-center">
                              <ImageIcon className="h-12 w-12 text-muted-foreground" />
                            </div>
                          )}
                        </div>
                        <CardContent className="p-4">
                          <h3 className="font-semibold mb-1">{service.name}</h3>
                          {service.description && (
                            <p className="text-sm text-muted-foreground mb-2 line-clamp-2">
                              {service.description}
                            </p>
                          )}
                          <div className="flex items-center justify-between">
                            <span className="text-lg font-bold text-primary">
                              ${parseFloat(service.price.toString()).toFixed(2)}
                            </span>
                            {service.duration && (
                              <span className="text-xs text-muted-foreground">
                                {service.duration}
                              </span>
                            )}
                          </div>
                          {service.category && (
                            <div className="mt-2">
                              <span className="text-xs bg-secondary px-2 py-1 rounded">
                                {service.category}
                              </span>
                            </div>
                          )}
                          {(service.city || service.state) && (
                            <div className="mt-2 text-xs text-muted-foreground">
                              {[service.city, service.state]
                                .filter(Boolean)
                                .join(", ")}
                            </div>
                          )}
                        </CardContent>
                      </Card>
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>
          </TabsContent>
        </Tabs>
      )}

      <AddProductSheet
        open={isAddingProduct}
        onOpenChange={setIsAddingProduct}
        companies={companies}
        selectedCompanyId={selectedCompanyId}
        onSuccess={handleProductAdded}
      />

      <AddServiceSheet
        open={isAddingService}
        onOpenChange={setIsAddingService}
        companies={companies}
        selectedCompanyId={selectedCompanyId}
        onSuccess={handleServiceAdded}
      />
    </div>
  );
}
